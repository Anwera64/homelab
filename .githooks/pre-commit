#!/bin/sh
# ==============================================================================
# Homelab Git Pre-Commit Hook
# Validates unit tests and docker-compose configuration prior to every commit.
# ==============================================================================

echo "🔍 [Pre-Commit] Running automated validation checks..."

# 1. Run Node.js Unit Tests
echo "  [+] Running unit & integrity test suites (node --test)..."
node --test
TEST_EXIT_CODE=$?

if [ $TEST_EXIT_CODE -ne 0 ]; then
  echo ""
  echo "❌ [Pre-Commit FAILED] Unit tests failed! Commit aborted."
  exit 1
fi

# 2. Validate Docker Compose Configuration
echo "  [+] Validating docker-compose.yml configuration..."
if command -v docker >/dev/null 2>&1; then
  ENV_FILE=".env"
  if [ ! -f "$ENV_FILE" ]; then
    ENV_FILE=".env.example"
  fi
  docker compose -f docker-compose.yml --env-file "$ENV_FILE" config -q
  COMPOSE_EXIT_CODE=$?
  if [ $COMPOSE_EXIT_CODE -ne 0 ]; then
    echo ""
    echo "❌ [Pre-Commit FAILED] docker-compose.yml validation failed! Commit aborted."
    exit 1
  fi
fi

# 3. Validate Clean Architecture Module Boundaries
if [ -d "apps/household-hub/backend" ]; then
  echo "  [+] Validating Clean Architecture module boundaries..."
  if [ -f "apps/household-hub/backend/.venv/Scripts/python.exe" ]; then
    apps/household-hub/backend/.venv/Scripts/python.exe -m pytest apps/household-hub/backend/tests/architecture -q
  elif command -v python3 >/dev/null 2>&1; then
    python3 -m pytest apps/household-hub/backend/tests/architecture -q
  elif command -v python >/dev/null 2>&1; then
    python -m pytest apps/household-hub/backend/tests/architecture -q
  fi
  ARCH_EXIT_CODE=$?
  if [ $ARCH_EXIT_CODE -ne 0 ]; then
    echo ""
    echo "❌ [Pre-Commit FAILED] Clean Architecture boundary violations detected! Commit aborted."
    exit 1
  fi
fi

# 4. Validate Household Hub client (KMP) boundaries, DI graph and design tokens
if git diff --cached --name-only | grep -q '^apps/household-hub/client/'; then
  echo "  [+] Validating client Clean Architecture boundaries, Koin graph and design tokens..."
  (cd apps/household-hub/client && ./gradlew :shared:jvmTest \
    --tests "*CleanArchitectureBoundaryTest*" --tests "*KoinDependencyGraphTest*" \
    --tests "*DesignSystemTokenTest*" -q --console=plain)
  CLIENT_EXIT_CODE=$?
  if [ $CLIENT_EXIT_CODE -ne 0 ]; then
    echo ""
    echo "❌ [Pre-Commit FAILED] Client boundary, DI graph or design-token checks failed! Commit aborted."
    exit 1
  fi
fi

echo "✅ [Pre-Commit PASSED] All tests and configuration validations passed!"
exit 0

