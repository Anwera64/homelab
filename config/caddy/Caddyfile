# ==============================================================================
# Caddyfile - Homelab Reverse Proxy Configuration
# ==============================================================================

{
    admin off
}

# ------------------------------------------------------------------------------
# 1. Main Dashboard Entrypoints (Homepage)
# ------------------------------------------------------------------------------
# Tailscale HTTPS/HTTP, Default Port 80, localhost, desktop-kujo8mp, and LAN IP
homelab.llama-porbeagle.ts.net, http://desktop-kujo8mp, http://desktop-kujo8mp.local, http://homelab.local, http://localhost, http://192.168.1.20, http://home.local, :80 {
    reverse_proxy homepage:3000
}

