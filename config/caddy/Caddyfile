# ==============================================================================
# Caddyfile - Desktop LAN gateway: publishes the containers on 192.168.1.20 ports.
# HTTPS for *.spicy-llama.duckdns.org is served by the Pi (hosts/pi/caddy/Caddyfile),
# which forwards desktop services to these ports.
# ==============================================================================

{
    admin off
}

# Reusable security headers snippet
(security_headers) {
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

# ------------------------------------------------------------------------------
# 1. Local LAN & Fallback Entrypoints (Pure HTTP :80)
# ------------------------------------------------------------------------------
http://desktop-kujo8mp, http://desktop-kujo8mp.local, http://homelab.local, http://localhost, http://192.168.1.20, http://home.local, :80 {
    import security_headers
    reverse_proxy 192.168.1.35:3000
}

http://:3000 {
    import security_headers
    reverse_proxy 192.168.1.35:3000
}

# Gluetun control API, for the Pi's Homepage widget (authenticated by GLUETUN_API_KEY)
http://:8000 {
    reverse_proxy gluetun:8000
}

# ------------------------------------------------------------------------------
# 2. Direct Local LAN Ports (Pure HTTP)
# ------------------------------------------------------------------------------
http://:8096 {
    handle_path /emby/* {
        reverse_proxy jellyfin:8096
    }
    reverse_proxy jellyfin:8096
}

http://:5055 {
    reverse_proxy seerr:5055
}

http://:3005 {
    reverse_proxy jellystat:3000
}

http://:6246 {
    reverse_proxy maintainerr:6246
}

http://:8080 {
    reverse_proxy gluetun:8080
}

http://:8989 {
    reverse_proxy sonarr:8989
}

http://:7878 {
    reverse_proxy radarr:7878
}

http://:9696 {
    reverse_proxy prowlarr:9696
}

http://:6767 {
    reverse_proxy bazarr:6767
}

http://:8191 {
    reverse_proxy flaresolverr:8191
}

# Household Hub on the LAN, for the Pi's Caddy (hub.spicy-llama.duckdns.org)
http://:3051 {
    reverse_proxy household-hub:3050
}
