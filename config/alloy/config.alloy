// =============================================================================
// Alloy - reads every container's output through the Docker socket and ships
// it to Loki. Label a container logs=off to leave it out. It also receives the
// app's logs over OTLP (port 4318, reached through the Pi's Caddy).
// =============================================================================

discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  // The default is a minute: a container that crashes at start would be gone before it was seen.
  refresh_interval = "5s"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_logs"]
    regex         = "off"
    action        = "drop"
  }

  // Docker names a container "/household-hub"; search by "household-hub".
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  // The Pi's containers slot in later under their own host.
  labels     = {
    host = "desktop",
  }
  forward_to = [loki.process.containers.receiver]
}

loki.process "containers" {
  forward_to = [loki.write.loki.receiver]

  // Docker's health check and Caddy's sign-in check before each telemetry batch: the
  // answered ones say nothing and would drown the rest. Failures are kept.
  stage.match {
    selector            = "{container=\"household-hub\"} |~ \"\\\"GET /api/v1/(health|auth/verify)[^\\\"]*\\\" 20[04]\""
    action              = "drop"
    drop_counter_reason = "hub_probe_answered"
  }
}

// The app's logs. Caddy has already asked the hub who is signed in and set X-Member-Id.
otelcol.receiver.otlp "app" {
  http {
    endpoint         = "0.0.0.0:4318"
    include_metadata = true
  }

  output {
    logs = [otelcol.processor.attributes.app.input]
  }
}

otelcol.processor.attributes "app" {
  action {
    key          = "member.id"
    action       = "upsert"
    from_context = "metadata.x-member-id"
  }

  // Loki labels: {service_name="household-hub-app", member_id="..."}.
  action {
    key    = "loki.attribute.labels"
    action = "insert"
    value  = "member.id"
  }

  action {
    key    = "loki.resource.labels"
    action = "insert"
    value  = "service.name"
  }

  output {
    logs = [otelcol.processor.batch.app.input]
  }
}

otelcol.processor.batch "app" {
  output {
    logs = [otelcol.exporter.loki.app.input]
  }
}

otelcol.exporter.loki "app" {
  forward_to = [loki.write.loki.receiver]
}

loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
