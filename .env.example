# ==============================================================================
# Homelab Media Stack Environment Configuration (.env)
# ==============================================================================

# Timezone (e.g. America/Mexico_City, America/New_York, UTC)
TZ=America/Mexico_City

# Container Configuration Data Storage Path
CONFIG_PATH=./config

# Media Directory Paths on Host (Windows paths with forward slashes)
MEDIA_ROOT=C:/Users/Anwera97
MOVIES_PATH=C:/Users/Anwera97/Videos/Movies
SHOWS_PATH=C:/Users/Anwera97/Videos/Shows
DOWNLOADS_PATH=C:/Users/Anwera97/Downloads

# ------------------------------------------------------------------------------
# VPN Configuration (Gluetun + NordVPN via WireGuard)
# ------------------------------------------------------------------------------
# Retrieve your WireGuard Private Key from NordVPN (or NordLynx configuration)
WIREGUARD_PRIVATE_KEY=your_nordvpn_wireguard_private_key_here

# Country for VPN connection (e.g. "United States", "Mexico", "Canada", etc.)
VPN_COUNTRY=United States

# ------------------------------------------------------------------------------
# Tailscale & DuckDNS Remote Access Configuration
# ------------------------------------------------------------------------------
# Generate an Auth Key from https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=your_tailscale_auth_key_here
TS_HOSTNAME=homelab
TS_ROUTES=192.168.1.0/24

# DuckDNS Domain & API Token (from https://www.duckdns.org)
DOMAIN_NAME=spicy-llama.duckdns.org
DUCKDNS_TOKEN=your_duckdns_token_here

# ------------------------------------------------------------------------------
# Service API Keys (Homepage Telemetry & Integrations)
# ------------------------------------------------------------------------------
GLUETUN_API_KEY=your_gluetun_api_key_here
JELLYFIN_API_KEY=your_jellyfin_api_key_here
JELLYSEERR_API_KEY=your_jellyseerr_api_key_here
SONARR_API_KEY=your_sonarr_api_key_here
RADARR_API_KEY=your_radarr_api_key_here
PROWLARR_API_KEY=your_prowlarr_api_key_here
BAZARR_API_KEY=your_bazarr_api_key_here
JELLYSTAT_API_KEY=your_jellystat_api_key_here

# ------------------------------------------------------------------------------
# Jellystat Database & Session Secrets (Optional overrides)
# ------------------------------------------------------------------------------
JELLYSTAT_DB_USER=jellystat
JELLYSTAT_DB_PASSWORD=jellystat_secure_password
JELLYSTAT_DB_NAME=jellystat
JELLYSTAT_JWT_SECRET=jellystat_jwt_secret_token_change_me


