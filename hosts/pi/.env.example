# Copy to hosts/pi/.env on the Pi (bootstrap.sh does this) and fill in. Never commit .env.

# Pi-hole admin page password. Generate one with: openssl rand -base64 18
PIHOLE_PASSWORD=
TZ=Europe/Madrid

# DHCP: true once the Livebox's DHCP server is deactivated (see README.md).
PIHOLE_DHCP_ACTIVE=false
# Static leases, ;-separated MAC,IP,name entries, e.g.
# PIHOLE_DHCP_HOSTS=aa:bb:cc:dd:ee:01,192.168.1.20,desktop;aa:bb:cc:dd:ee:02,192.168.1.35,lemonpi
PIHOLE_DHCP_HOSTS=

# DuckDNS token (same as the desktop .env): Caddy proves it owns the domain for the wildcard cert.
DUCKDNS_TOKEN=

# Maintainerr has no login of its own, so Caddy asks for this user and password on its name.
# Make the hash with: docker exec -it caddy caddy hash-password
# Keep the single quotes: the hash contains $ signs. Example: MAINTAINERR_PASSWORD_HASH='$2a$14$...'
MAINTAINERR_USER=
MAINTAINERR_PASSWORD_HASH=

# Homepage widget API keys for the desktop services (same values as the desktop .env).
JELLYFIN_API_KEY=
SEERR_API_KEY=
JELLYSTAT_API_KEY=
SONARR_API_KEY=
RADARR_API_KEY=
PROWLARR_API_KEY=
BAZARR_API_KEY=
GLUETUN_API_KEY=
# Cleanuparr: Settings, Account. Its login is on for local addresses too, so the widget needs the key.
CLEANUPARR_API_KEY=
# qBittorrent has no API key: the widget signs in with the web UI's user and password.
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
