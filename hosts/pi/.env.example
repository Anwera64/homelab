# Copy to hosts/pi/.env on the Pi (bootstrap.sh does this) and fill in. Never commit .env.

# Pi-hole admin page password. Generate one with: openssl rand -base64 18
PIHOLE_PASSWORD=
TZ=Europe/Madrid

# DHCP: true once the Livebox's DHCP server is deactivated (see README.md).
PIHOLE_DHCP_ACTIVE=false
# Static leases, ;-separated MAC,IP,name entries, e.g.
# PIHOLE_DHCP_HOSTS=aa:bb:cc:dd:ee:01,192.168.1.20,desktop;aa:bb:cc:dd:ee:02,192.168.1.35,lemonpi
PIHOLE_DHCP_HOSTS=
