# ==============================================================================
# Caddyfile - lemonpi HTTPS ingress (*.spicy-llama.duckdns.org -> 192.168.1.35)
# Pi-local services (Pi-hole, the dashboard, Uptime Kuma, ntfy) are served here.
# The rest go to the ports their containers
# publish on the server (192.168.1.30): the Hub, the logs and the media services.
# While it is off they answer 502.
# ==============================================================================

{
    admin off
}

(security_headers) {
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

*.spicy-llama.duckdns.org, spicy-llama.duckdns.org {
    import security_headers

    tls {
        dns duckdns {$DUCKDNS_TOKEN}
        resolvers 1.1.1.1 9.9.9.9
    }

    # On the Pi
    @pihole host pihole.spicy-llama.duckdns.org
    handle @pihole {
        reverse_proxy 127.0.0.1:8081
    }

    # Uptime checks and the alerts they push to the phones: here, so they outlive the server
    @uptime host uptime.spicy-llama.duckdns.org
    handle @uptime {
        reverse_proxy 127.0.0.1:3001
    }

    @ntfy host ntfy.spicy-llama.duckdns.org
    handle @ntfy {
        reverse_proxy 127.0.0.1:2586
    }

    # On the server: media
    @jellyfin host jellyfin.spicy-llama.duckdns.org
    handle @jellyfin {
        # Jellyfin 12 dropped the /emby prefix some clients still send.
        handle_path /emby/* {
            reverse_proxy 192.168.1.30:8096
        }
        reverse_proxy 192.168.1.30:8096
    }

    @seerr host seerr.spicy-llama.duckdns.org jellyseerr.spicy-llama.duckdns.org
    handle @seerr {
        reverse_proxy 192.168.1.30:5055
    }

    @stat host stat.spicy-llama.duckdns.org jellystat.spicy-llama.duckdns.org
    handle @stat {
        reverse_proxy 192.168.1.30:3005
    }

    @sonarr host sonarr.spicy-llama.duckdns.org
    handle @sonarr {
        reverse_proxy 192.168.1.30:8989
    }

    @radarr host radarr.spicy-llama.duckdns.org
    handle @radarr {
        reverse_proxy 192.168.1.30:7878
    }

    @prowlarr host prowlarr.spicy-llama.duckdns.org
    handle @prowlarr {
        reverse_proxy 192.168.1.30:9696
    }

    @bazarr host bazarr.spicy-llama.duckdns.org
    handle @bazarr {
        reverse_proxy 192.168.1.30:6767
    }

    @maintainerr host maintainerr.spicy-llama.duckdns.org
    handle @maintainerr {
        # Maintainerr has no login of its own.
        basic_auth {
            {$MAINTAINERR_USER} {$MAINTAINERR_PASSWORD_HASH}
        }
        reverse_proxy 192.168.1.30:6246
    }

    @qbit host qbit.spicy-llama.duckdns.org qbittorrent.spicy-llama.duckdns.org
    handle @qbit {
        reverse_proxy 192.168.1.30:8080
    }

    @cleanuparr host cleanuparr.spicy-llama.duckdns.org
    handle @cleanuparr {
        reverse_proxy 192.168.1.30:11011
    }

    # On the server: logs and the Hub
    @grafana host grafana.spicy-llama.duckdns.org
    handle @grafana {
        reverse_proxy 192.168.1.30:3002
    }

    # The app's logs, to Alloy on the server. The hub is asked whose token it is first;
    # it never sees the logs themselves.
    @telemetry host telemetry.spicy-llama.duckdns.org
    handle @telemetry {
        @logs {
            method POST
            path /v1/logs
        }
        handle @logs {
            # route keeps this order; Caddy's own would strip the header after the hub set it.
            route {
                request_header -X-Member-Id
                forward_auth 192.168.1.30:3051 {
                    uri /api/v1/auth/verify
                    copy_headers X-Member-Id
                }
                reverse_proxy 192.168.1.30:4318
            }
        }
        handle {
            respond 404
        }
    }

    @hub host hub.spicy-llama.duckdns.org
    handle @hub {
        reverse_proxy 192.168.1.30:3051
    }

    # Default / Dashboard (Homepage, on the Pi)
    handle {
        reverse_proxy 127.0.0.1:3000
    }
}

# Plain HTTP on the Pi's own names goes to the dashboard's HTTPS name.
http://192.168.1.35, http://lemonpi, http://lemonpi.lan, http://lemonpi.local {
    redir https://home.spicy-llama.duckdns.org{uri}
}
