# ==============================================================================
# Caddyfile - lemonpi HTTPS ingress (*.spicy-llama.duckdns.org -> 192.168.1.35)
# Pi-local services are served here; desktop services go to the ports their
# containers publish on 192.168.1.20, and fail with a 502 while the desktop is off.
# ==============================================================================

{
    admin off
}

(security_headers) {
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

*.spicy-llama.duckdns.org, spicy-llama.duckdns.org {
    import security_headers

    tls {
        dns duckdns {$DUCKDNS_TOKEN}
        resolvers 1.1.1.1 9.9.9.9
    }

    # On the Pi
    @pihole host pihole.spicy-llama.duckdns.org
    handle @pihole {
        reverse_proxy 127.0.0.1:8081
    }

    # On the desktop
    @jellyfin host jellyfin.spicy-llama.duckdns.org
    handle @jellyfin {
        # Jellyfin 12 dropped the /emby prefix some clients still send.
        handle_path /emby/* {
            reverse_proxy 192.168.1.20:8096
        }
        reverse_proxy 192.168.1.20:8096
    }

    @seerr host seerr.spicy-llama.duckdns.org jellyseerr.spicy-llama.duckdns.org
    handle @seerr {
        reverse_proxy 192.168.1.20:5055
    }

    @stat host stat.spicy-llama.duckdns.org jellystat.spicy-llama.duckdns.org
    handle @stat {
        reverse_proxy 192.168.1.20:3005
    }

    @sonarr host sonarr.spicy-llama.duckdns.org
    handle @sonarr {
        reverse_proxy 192.168.1.20:8989
    }

    @radarr host radarr.spicy-llama.duckdns.org
    handle @radarr {
        reverse_proxy 192.168.1.20:7878
    }

    @prowlarr host prowlarr.spicy-llama.duckdns.org
    handle @prowlarr {
        reverse_proxy 192.168.1.20:9696
    }

    @bazarr host bazarr.spicy-llama.duckdns.org
    handle @bazarr {
        reverse_proxy 192.168.1.20:6767
    }

    @maintainerr host maintainerr.spicy-llama.duckdns.org
    handle @maintainerr {
        reverse_proxy 192.168.1.20:6246
    }

    @qbit host qbit.spicy-llama.duckdns.org qbittorrent.spicy-llama.duckdns.org
    handle @qbit {
        reverse_proxy 192.168.1.20:8080
    }

    @flaresolverr host flaresolverr.spicy-llama.duckdns.org
    handle @flaresolverr {
        reverse_proxy 192.168.1.20:8191
    }

    @hub host hub.spicy-llama.duckdns.org
    handle @hub {
        reverse_proxy 192.168.1.20:3051
    }

    # Default / Dashboard (Homepage, on the Pi)
    handle {
        reverse_proxy 127.0.0.1:3000
    }
}

# Plain HTTP on the Pi's own names shows the dashboard.
http://192.168.1.35, http://lemonpi, http://lemonpi.lan, http://lemonpi.local {
    import security_headers
    reverse_proxy 127.0.0.1:3000
}
