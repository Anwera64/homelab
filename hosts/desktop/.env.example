# ==============================================================================
# The desktop's settings (.env): the chat model and its log shipper.
# The media services, the Hub and their keys are in hosts/server/.env.
# ==============================================================================

# Timezone (e.g. Europe/Madrid, UTC)
TZ=Europe/Madrid

# The shared config folder in the repo root, seen from this folder.
CONFIG_PATH=../../config

# ------------------------------------------------------------------------------
# Ollama
# ------------------------------------------------------------------------------
# How long an idle model stays in video memory (e.g. 15m, 5m, or 0m to unload at once):
OLLAMA_KEEP_ALIVE=15m

# Ollama KV cache (context) precision. q8_0 is half the size of full precision; set f16 to go back:
OLLAMA_KV_CACHE_TYPE=q8_0

# ------------------------------------------------------------------------------
# Logs: Alloy ships this machine's container logs to the server's Loki
# ------------------------------------------------------------------------------
# Optional; this is the default.
# LOKI_URL=http://192.168.1.30:3100/loki/api/v1/push
