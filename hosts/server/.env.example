# Copy to hosts/server/.env on the server (bootstrap.sh does this) and fill in. Never commit .env.

TZ=Europe/Madrid

# Plain `docker compose` commands cover the media services too. The disk guard stops
# them while the media disk is unplugged.
COMPOSE_PROFILES=media

# ------------------------------------------------------------------------------
# Paths
# ------------------------------------------------------------------------------
# App settings and databases, on the internal SSD (this repo's config folder).
CONFIG_PATH=/home/anwera97/homelab/config

# The media disk, in the TRaSH layout: /data/media/{movies,tv} and /data/torrents.
MEDIA_ROOT=/data
MOVIES_PATH=/data/media/movies
SHOWS_PATH=/data/media/tv

# The media disk's filesystem UUID (`lsblk -o NAME,UUID`). bootstrap.sh mounts it at /data.
# Left empty, no disk is mounted and the media services stay stopped.
DATA_DISK_UUID=

# ------------------------------------------------------------------------------
# Access
# ------------------------------------------------------------------------------
# Who may reach the published service ports, space-separated. lemonpi (Caddy and
# Homepage) is the only one that has to; everything else uses the HTTPS names.
SERVER_ALLOWED_SOURCES=192.168.1.35
# One port for one address, as port=address pairs, space-separated. The desktop's
# Alloy ships its logs to Loki (3100) and reaches nothing else here.
SERVER_PORT_SOURCES=3100=192.168.1.20

# ------------------------------------------------------------------------------
# VPN (Gluetun, over WireGuard)
# ------------------------------------------------------------------------------
# Optional; NordVPN is the default. The key below belongs to this provider.
# VPN_PROVIDER=nordvpn
WIREGUARD_PRIVATE_KEY=
VPN_COUNTRY=United States
GLUETUN_API_KEY=
# Optional. Port forwarding lets other peers reach qBittorrent. NordVPN has none;
# ProtonVPN has it on paid plans (README.md, "VPN provider").
# VPN_PORT_FORWARDING=off
# VPN_PORT_FORWARD_ONLY=off
# Optional. HTTP proxy through the VPN for indexers in the stack (Prowlarr at http://gluetun:8888).
# HTTPPROXY=on
# HTTPPROXY_STEALTH=on

# ------------------------------------------------------------------------------
# Service keys and secrets (same values as on the desktop when migrating)
# ------------------------------------------------------------------------------
SONARR_API_KEY=
RADARR_API_KEY=
# 64 hex chars: openssl rand -hex 32
SEARXNG_SECRET=

JELLYSTAT_DB_USER=jellystat
JELLYSTAT_DB_NAME=jellystat
JELLYSTAT_DB_PASSWORD=
JELLYSTAT_JWT_SECRET=

# ------------------------------------------------------------------------------
# Household Hub
# ------------------------------------------------------------------------------
DOMAIN_NAME=spicy-llama.duckdns.org
# Signs every login and encrypts the stored calendar credentials: openssl rand -hex 32
# Set it once. Changing it later signs every phone out, and the calendar credentials
# in the database must be re-encrypted with the new key first (see README.md).
HUB_SECRET_KEY=
# The chat model runs on the desktop's GPU. Optional; this is the default.
# (The embedder runs here, in the stack's own Ollama, and needs no setting.)
# OLLAMA_BASE_URL=http://192.168.1.20:11434
# Google Calendar sign-in (OAuth web client); empty leaves Google unavailable in the app.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional; defaults to https://hub.<DOMAIN_NAME>
# HUB_PUBLIC_URL=https://hub.spicy-llama.duckdns.org

# ------------------------------------------------------------------------------
# Logs: Grafana sign-in
# ------------------------------------------------------------------------------
# Optional. Read only on Grafana's first start; left unset it is admin / admin,
# and Grafana asks for a new password at the first login.
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=
# GRAFANA_RENDERER_TOKEN=

# ------------------------------------------------------------------------------
# Version bumps (Renovate)
# ------------------------------------------------------------------------------
# A fine-grained GitHub token for Anwera64/homelab only; README.md lists the
# permissions it needs. Left empty, Renovate does not run.
RENOVATE_TOKEN=
